# Supply-chain hardening (needs npm >= 11.19; Node 24's bundled npm has it).

# Only resolve versions published at least 7 days ago, so a compromised
# release is usually caught and pulled before it can reach the lockfile.
# For an urgent security fix, add the package to min-release-age-exclude.
min-release-age=7

# Fail the install when a dependency has install scripts that aren't covered
# by the allowScripts policy in package.json.
strict-allow-scripts=true

# Only install from the registry, never from git repos or tarball URLs.
allow-git=none
allow-remote=none
