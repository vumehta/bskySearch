{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsky-search-monitor",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "bsky-search-monitor", "migrations_dir": "worker/migrations" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "dev": { "port": 8787 }
}
