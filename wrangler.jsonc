{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bskysearch",
  "main": "worker/index.mjs",
  // The newest date the pinned workerd supports; bump it together with wrangler.
  "compatibility_date": "2026-09-21",
  // Lets request.signal abort when the browser abandons a search or topic check.
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // The Worker serves the page so each response gets its own CSP nonce.
    "run_worker_first": ["/"]
  },
  "workers_dev": false,
  // Worker Previews are served on workers.dev, so their URLs stay on although production isn't.
  "preview_urls": true,
  "routes": [
    { "pattern": "bskysearch.vum.sh", "custom_domain": true }
  ],
  "ratelimits": [
    {
      "name": "CLASSIFY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  // Previews inherit no bindings or settings from production. Their secrets are in the
  // dashboard's Previews Base; a separate namespace keeps their topic-check counts apart.
  "previews": {
    "ratelimits": [
      {
        "name": "CLASSIFY_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 30, "period": 60 }
      }
    ],
    "observability": {
      "enabled": true
    }
  }
}
