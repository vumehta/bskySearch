{
  "name": "bskysearch",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "minify:js": "esbuild src/app.mjs --bundle --minify --platform=browser --format=iife --target=es2019 --outfile=app.min.js",
    "minify:css": "esbuild styles.css --minify --outfile=styles.min.css",
    "build": "npm run minify:js && npm run minify:css && node scripts/prepare-dist.js",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vumehta/bskySearch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vumehta/bskySearch/issues"
  },
  "homepage": "https://github.com/vumehta/bskySearch#readme",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@atproto/syntax": "^0.7.5"
  }
}
