  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vumehta/bskySearch/issues"
  },
  "homepage": "https://github.com/vumehta/bskySearch#readme",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "devDependencies": {
    "cssnano": "^8.0.8",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@atproto/syntax": "^0.7.5"
  }
